{% extends '@WebProfiler/Profiler/layout.html.twig' %}

{% macro icon() %}
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <ellipse cx="9" cy="5" rx="6" ry="2.5"/>
        <path d="M3 5v10c0 1.4 2.7 2.5 6 2.5"/>
        <path d="M15 5v4"/>
        <path d="M3 10c0 1.4 2.7 2.5 6 2.5"/>
        <rect x="13" y="12" width="8" height="9" rx="1"/>
        <path d="M15 15h4M15 18h4"/>
    </svg>
{% endmacro %}

{% macro milliseconds(nanoseconds) %}{{ '%0.2f'|format(nanoseconds / 1000000) }}&nbsp;ms{% endmacro %}

{% block toolbar %}
    {% set traces = collector.traces %}
    {% if traces|length > 0 %}
        {% set failed_traces = traces|filter(trace => trace.exception is not null) %}
        {% set query_duration = traces|reduce((carry, trace) => carry + (trace.stageDurationsInNanoseconds.raw ?? 0), 0) %}
        {% set total_duration = traces|reduce((carry, trace) => carry + trace.stageDurationsInNanoseconds|reduce((sum, duration) => sum + duration, 0), 0) %}

        {% set icon %}
            {{ _self.icon() }}
            <span class="sf-toolbar-value">{{ traces|length }}</span>
            <span class="sf-toolbar-info-piece-additional-detail">
                <span class="sf-toolbar-label">in</span>
                <span class="sf-toolbar-value">{{ '%0.2f'|format(total_duration / 1000000) }}</span>
                <span class="sf-toolbar-label">ms</span>
            </span>
        {% endset %}

        {% set text %}
            <div class="sf-toolbar-info-piece">
                <b>Usages</b>
                <span class="sf-toolbar-status">{{ traces|length }}</span>
            </div>
            <div class="sf-toolbar-info-piece">
                <b>Failed usages</b>
                <span class="sf-toolbar-status {{ failed_traces|length > 0 ? 'sf-toolbar-status-red' }}">{{ failed_traces|length }}</span>
            </div>
            <div class="sf-toolbar-info-piece">
                <b>Query time</b>
                <span>{{ _self.milliseconds(query_duration) }}</span>
            </div>
            <div class="sf-toolbar-info-piece">
                <b>Total time</b>
                <span>{{ _self.milliseconds(total_duration) }}</span>
            </div>
        {% endset %}

        {{ include('@WebProfiler/Profiler/toolbar_item.html.twig', {
            link: profiler_url,
            status: failed_traces|length > 0 ? 'red' : '',
        }) }}
    {% endif %}
{% endblock %}

{% block menu %}
    {% set failed_traces = collector.traces|filter(trace => trace.exception is not null) %}
    <span class="label {{ collector.traces|length == 0 ? 'disabled' }} {{ failed_traces|length > 0 ? 'label-status-error' }}">
        <span class="icon">{{ _self.icon() }}</span>
        <strong>Deserializing Connection</strong>
        {% if failed_traces|length > 0 %}
            <span class="count"><span>{{ failed_traces|length }}</span></span>
        {% endif %}
    </span>
{% endblock %}

{% block head %}
    {{ parent() }}
    <style>
        .highlight .keyword   { color: var(--highlight-keyword); font-weight: bold; }
        .highlight .word      { color: var(--color-text); }
        .highlight .variable  { color: var(--highlight-variable); }
        .highlight .symbol    { color: var(--color-text); }
        .highlight .comment   { color: var(--highlight-comment); }
        .highlight .string    { color: var(--highlight-string); }
        .highlight .number    { color: var(--highlight-constant); font-weight: bold; }
        .deserializing-connection-nowrap { white-space: nowrap; }
        .queries-table pre.highlight { word-break: normal; overflow-wrap: anywhere; hyphens: none; -webkit-hyphens: none; }
        .deserializing-connection-usage { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 8px; margin-bottom: 8px; font-family: var(--font-family-system); font-size: var(--font-size-body); }
        .deserializing-connection-usage .btn { margin-left: auto; }
        .deserializing-connection-exception { color: var(--color-error); margin-bottom: 8px; }
        table tbody tr.deserializing-connection-step td { border-top: 0; padding-top: 2px; padding-bottom: 2px; }
        table tbody tr.deserializing-connection-step:last-child td { padding-bottom: 10px; }
        table tbody.deserializing-connection-usage-rows tr:not(:last-child) td { border-bottom: 0; }
        .deserializing-connection-step-content { display: flex; gap: 8px; align-items: baseline; margin: 0; }
        .deserializing-connection-step-label { flex: 0 0 110px; font-family: var(--font-family-system); font-size: var(--font-size-body); color: var(--color-muted); }
        .deserializing-connection-step-content pre.sf-dump { margin: 0; flex: 1; min-width: 0; }
    </style>
{% endblock %}

{% block panel %}
    {% set stage_labels = {
        raw: 'Raw result',
        decoded: 'Decoded',
        transformed: 'Transformed',
        denormalized: 'Denormalized',
    } %}
    {% set traces = collector.traces %}
    {% set failed_traces = traces|filter(trace => trace.exception is not null) %}
    {% set query_duration = traces|reduce((carry, trace) => carry + (trace.stageDurationsInNanoseconds.raw ?? 0), 0) %}
    {% set total_duration = traces|reduce((carry, trace) => carry + trace.stageDurationsInNanoseconds|reduce((sum, duration) => sum + duration, 0), 0) %}

    <h2>Deserializing Connection</h2>

    <div class="metrics">
        <div class="metric-group">
            <div class="metric">
                <span class="value">{{ traces|length }}</span>
                <span class="label">Usages</span>
            </div>
            <div class="metric">
                <span class="value">{{ failed_traces|length }}</span>
                <span class="label">Failed usages</span>
            </div>
            <div class="metric">
                <span class="value">{{ '%0.2f'|format(query_duration / 1000000) }} <span class="unit">ms</span></span>
                <span class="label">Query time</span>
            </div>
            <div class="metric">
                <span class="value">{{ '%0.2f'|format(total_duration / 1000000) }} <span class="unit">ms</span></span>
                <span class="label">Total time</span>
            </div>
        </div>
    </div>

    {% if traces|length == 0 %}
        <div class="empty empty-panel">
            <p>Neither the DeserializingConnection nor the DecodingConnection were used.</p>
        </div>
    {% else %}
        <table class="alt queries-table">
            <thead>
                <tr>
                    <th class="deserializing-connection-nowrap">#</th>
                    <th class="deserializing-connection-nowrap">Time</th>
                    <th style="width: 100%;">Info</th>
                </tr>
            </thead>
            {% for trace in traces %}
                {% set durations = trace.stageDurationsInNanoseconds %}
                {% set status = trace.exception is not null ? 'status-error' : '' %}
                <tbody class="deserializing-connection-usage-rows">
                    <tr class="{{ status }}">
                        <td class="deserializing-connection-nowrap">{{ loop.index }}</td>
                        <td class="deserializing-connection-nowrap">{{ _self.milliseconds(durations|reduce((sum, duration) => sum + duration, 0)) }}</td>
                        <td>
                            <div class="deserializing-connection-usage">
                                <strong>{{ trace.method|split('::')|last }}</strong>
                                <span class="text-muted">{{ trace.method|split('::')|first|split('\\')|last }}</span>
                                {% if trace.caller is not null %}
                                    <span class="text-small">{{ trace.caller.file|format_file(trace.caller.line) }}</span>
                                {% endif %}
                                {% if trace.runnableSql is not null %}
                                    <button class="btn btn-sm hidden" data-clipboard-text="{{ trace.runnableSql|e('html_attr') }}">Copy query</button>
                                {% endif %}
                            </div>

                            {% if trace.exception is not null %}
                                <div class="deserializing-connection-exception">
                                    <strong>{{ trace.exceptionClass|split('\\')|last }}</strong>: {{ trace.exceptionMessage }}
                                </div>
                            {% endif %}

                            {{ trace.highlightedSql|raw }}

                            {% if trace.runnableSql is null %}
                                <p class="text-small text-muted">{{ trace.runnableSqlError }} The query is shown with placeholders.</p>
                            {% endif %}
                        </td>
                    </tr>
                    {% for stage, label in stage_labels %}
                        {% if trace.stages[stage] is defined %}
                            <tr class="deserializing-connection-step {{ status }}">
                                <td></td>
                                <td class="deserializing-connection-nowrap">{{ _self.milliseconds(durations[stage] ?? 0) }}</td>
                                <td>
                                    <div class="deserializing-connection-step-content">
                                        <span class="deserializing-connection-step-label">{{ label }}</span>
                                        {{ profiler_dump(trace.stages[stage], maxDepth=0) }}
                                    </div>
                                </td>
                            </tr>
                        {% endif %}
                    {% endfor %}
                    <tr class="deserializing-connection-step {{ status }}">
                        <td></td>
                        <td></td>
                        <td>
                            <div class="deserializing-connection-step-content">
                                <span class="deserializing-connection-step-label">Configuration</span>
                                {{ profiler_dump(trace.configuration, maxDepth=0) }}
                            </div>
                        </td>
                    </tr>
                    {% if trace.exception is not null %}
                        <tr class="deserializing-connection-step {{ status }}">
                            <td></td>
                            <td></td>
                            <td>
                                <div class="deserializing-connection-step-content">
                                    <span class="deserializing-connection-step-label">Exception</span>
                                    {{ profiler_dump(trace.exception, maxDepth=0) }}
                                </div>
                            </td>
                        </tr>
                    {% endif %}
                </tbody>
            {% endfor %}
        </table>
    {% endif %}
{% endblock %}
