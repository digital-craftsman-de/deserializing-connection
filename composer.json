{
  "name": "digital-craftsman/deserializing-connection",
  "description": "Get DTOs directly from the database",
  "type": "symfony-bundle",
  "require": {
    "php": "8.5.*|8.6.*",
    "digital-craftsman/self-aware-normalizers": "^1.4.0",
    "doctrine/dbal": "^4.5",
    "doctrine/sql-formatter": "^1.5",
    "symfony/framework-bundle": "^7.4|^8.0",
    "symfony/serializer": "^7.4|^8.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95",
    "digital-craftsman/ids": "^2.5.0",
    "infection/infection": "^0.35",
    "phpunit/phpunit": "^13.4",
    "symfony/property-access": "^7.4|^8.0",
    "symfony/property-info": "^7.4|^8.0",
    "vimeo/psalm": "^6.20"
  },
  "autoload": {
    "psr-4": {
      "DigitalCraftsman\\DeserializingConnection\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "DigitalCraftsman\\DeserializingConnection\\": "tests/"
    }
  },
  "license": "MIT",
  "authors": [
    {
      "name": "Christian Kolb",
      "email": "info@digital-craftsman.de"
    }
  ],
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "infection/extension-installer": true
    }
  }
}
